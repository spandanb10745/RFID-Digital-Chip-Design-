create_clock [get_ports PCLK]  -period 20  -waveform {0 10}
set_clock_uncertainty -setup 0.5  [get_clocks PCLK]
set_clock_uncertainty -hold 0.1  [get_clocks PCLK]
set_clock_transition -max -rise 0.2 [get_clocks PCLK]
